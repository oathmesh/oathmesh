# =============================================================================
# OathMesh .gitignore — Production MVP V1
# =============================================================================

# ── Binaries & Build Output ──────────────────────────────────────────────────
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Go ───────────────────────────────────────────────────────────────────────
go.work
go.work.sum

# ── Secrets & Credentials (NEVER commit) ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
conformance/test-key.pem
conformance/results_*.json

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Test & Coverage ──────────────────────────────────────────────────────────
*.out
coverage.txt
coverage.html
*.cover
*.prof

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.venv/
venv/
*.egg
dist/

# ── Temporary & Generated ───────────────────────────────────────────────────
*.tmp
*.log
*.bak
*.orig

# ── Next.js ──────────────────────────────────────────────────────────────────
.next/

# ── Tool-specific (not project code) ────────────────────────────────────────
.antigravity/
docs/session-logs/
*.txt
ANTIGRAVITY.md
oathmesh-prompt.md
.kilo/
