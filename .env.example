# OathMesh Issuer Configuration

# REQUIRED: Ed25519 private key in PEM PKCS8 format
# Generate with: openssl genpkey -algorithm Ed25519 -out private.pem
# Export as: export OATHMESH_PRIVATE_KEY="$(cat private.pem)"
# DO NOT commit this file - keep it in .gitignore
OATHMESH_PRIVATE_KEY=

# OPTIONAL: Path to private key file (dev only, prefer env var in production)
OATHMESH_PRIVATE_KEY_FILE=

# REQUIRED: Issuer URL (must be HTTPS in production)
OATHMESH_ISSUER=https://issuer.oathmesh.dev

# OPTIONAL: Server listen port (default: 4000)
OATHMESH_PORT=4000

# OPTIONAL: Rate limiting (requests per minute, default: 100)
OATHMESH_RATE_LIMIT_RPM=100

# OPTIONAL: Rate limit burst size (default: 20)
OATHMESH_RATE_LIMIT_BURST=20

# OPTIONAL: Audit sink - "stdout" | "file" | "noop" (default: stdout)
OATHMESH_AUDIT_SINK=stdout

# OPTIONAL: Audit file path (required when sink = file)
OATHMESH_AUDIT_FILE_PATH=

# OPTIONAL: Replay cache backend - "memory" | "redis" (default: memory)
OATHMESH_REPLAY_CACHE_BACKEND=memory

# OPTIONAL: Redis URL (required when replay cache = redis)
# Format: redis://localhost:6379/0
OATHMESH_REDIS_URL=

# OPTIONAL: JWKS cache TTL in seconds (default: 300)
OATHMESH_JWKS_CACHE_TTL=300
