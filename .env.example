# =============================================================================
# OathMesh Environment Configuration
# Copy to .env and fill in values. NEVER commit .env itself.
# =============================================================================

# ── Issuer (Required) ────────────────────────────────────────────────────────

# Ed25519 private key — full PEM string including headers.
# Generate: openssl genpkey -algorithm Ed25519 -out private.pem
# Export:   export OATHMESH_PRIVATE_KEY="$(cat private.pem)"
OATHMESH_PRIVATE_KEY=

# Dev only: load key from file instead of env var.
# Ignored if OATHMESH_PRIVATE_KEY is set.
OATHMESH_PRIVATE_KEY_FILE=./private.pem

# Canonical issuer URL.
# MUST be https:// in production. Plain HTTP exposes JWKS fetch
# to interception and violates the threat model. localhost is
# acceptable only for local development.
OATHMESH_ISSUER=http://localhost:4000

# Server listen port.
OATHMESH_PORT=4000

# ── TTL ──────────────────────────────────────────────────────────────────────

# Default token TTL in seconds (max: 300).
OATHMESH_TTL_DEFAULT=120

# Hard ceiling for TTL — callers cannot exceed this.
OATHMESH_TTL_MAX=300

# Recommended TTL for write/mutate operations.
OATHMESH_TTL_WRITE=60

# ── Rate Limiting ────────────────────────────────────────────────────────────

# Requests per minute per source IP on the mint endpoint.
OATHMESH_RATE_LIMIT_RPM=100

# Burst size above the steady-state rate.
OATHMESH_RATE_LIMIT_BURST=20

# ── Audit ────────────────────────────────────────────────────────────────────

# Audit sink: stdout | file | noop (noop is testing only)
OATHMESH_AUDIT_SINK=stdout

# File path when OATHMESH_AUDIT_SINK=file.
OATHMESH_AUDIT_FILE=

# ── Replay Cache ─────────────────────────────────────────────────────────────

# Redis URL for the replay cache (production).
# Format: redis://localhost:6379/0
REDIS_URL=

# ── JWKS ─────────────────────────────────────────────────────────────────────

# In-memory JWKS cache TTL in seconds.
OATHMESH_JWKS_CACHE_TTL=300

# Emergency JWKS cache TTL for key compromise scenarios.
# Set to 0 before emergency key rotation so receivers immediately re-fetch.
# After rotation, restore to normal value (300).
# Default: same as OATHMESH_JWKS_CACHE_TTL
OATHMESH_JWKS_CACHE_TTL_EMERGENCY=300

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: debug | info | warn | error
OATHMESH_LOG_LEVEL=info

# ── Gateway Mode ─────────────────────────────────────────────────────────────

# Upstream service URL to proxy verified requests to.
OATHMESH_GATEWAY_UPSTREAM=http://localhost:8080

# Expected audience of incoming tokens.
OATHMESH_GATEWAY_AUDIENCE=https://api.internal

# Comma-separated list of trusted issuer URLs.
OATHMESH_GATEWAY_ISSUERS=http://localhost:4000

# Path to the Pkl or JSON policy file.
OATHMESH_GATEWAY_POLICY=./policy/production.json
