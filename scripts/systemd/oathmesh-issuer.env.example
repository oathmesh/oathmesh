# OathMesh issuer runtime environment example.
# Copy to /etc/oathmesh/issuer.env and set real values securely.
# Do not commit real secrets.

# Canonical external issuer URL (HTTPS in production).
OATHMESH_ISSUER=https://issuer.example.internal

# HTTP listen port for `oathmesh serve`.
OATHMESH_PORT=4000

# Mint endpoint shared secret (inject from secret manager/runtime).
OATHMESH_MINT_SECRET=__SET_AT_RUNTIME__

# Path to Ed25519 private key file (PEM PKCS8), permission-restricted.
OATHMESH_PRIVATE_KEY_FILE=/etc/oathmesh/private.pem

# Production hardening and telemetry defaults.
OATHMESH_ENV=production
OATHMESH_LOG_LEVEL=info
OATHMESH_AUDIT_SINK=stdout

# Replay cache / revocation backend.
REDIS_URL=redis://127.0.0.1:6379/0
