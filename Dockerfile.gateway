# ── Build stage ──────────────────────────────────────────────────────────────
FROM golang:1.23-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /oathmesh ./cmd/oathmesh

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app
COPY --from=builder /oathmesh ./bin/oathmesh

EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:4000/healthz || exit 1

# Separate images limit attack surface per container.
# This image runs in gateway mode only.
ENTRYPOINT ["./bin/oathmesh"]
CMD ["serve", "--gateway"]