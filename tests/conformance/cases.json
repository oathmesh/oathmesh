{
  "version": "phase2-p2-conformance-framework",
  "targets": [
    "go",
    "node",
    "python"
  ],
  "cases": [
    {
      "id": "token_parsing_validation_failures",
      "category": "verification",
      "description": "Malformed token input is rejected.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./internal/verify",
            "-run",
            "^TestConformance_token_parsing_validation_failures$",
            "-count=1"
          ]
        },
        "node": {
          "command": [
            "npx",
            "vitest",
            "run",
            "test/conformance.test.ts",
            "-t",
            "token_parsing_validation_failures"
          ],
          "cwd": "sdk/node"
        },
        "python": {
          "command": [
            "python",
            "-m",
            "pytest",
            "tests/test_conformance.py",
            "-k",
            "token_parsing_validation_failures",
            "-q"
          ],
          "cwd": "sdk/python"
        }
      }
    },
    {
      "id": "issuer_check_untrusted",
      "category": "verification",
      "description": "Untrusted issuer is rejected.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./internal/verify",
            "-run",
            "^TestConformance_issuer_check_untrusted$",
            "-count=1"
          ]
        },
        "node": {
          "command": [
            "npx",
            "vitest",
            "run",
            "test/conformance.test.ts",
            "-t",
            "issuer_check_untrusted"
          ],
          "cwd": "sdk/node"
        },
        "python": {
          "command": [
            "python",
            "-m",
            "pytest",
            "tests/test_conformance.py",
            "-k",
            "issuer_check_untrusted",
            "-q"
          ],
          "cwd": "sdk/python"
        }
      }
    },
    {
      "id": "audience_check_mismatch",
      "category": "verification",
      "description": "Audience mismatch is rejected.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./internal/verify",
            "-run",
            "^TestConformance_audience_check_mismatch$",
            "-count=1"
          ]
        },
        "node": {
          "command": [
            "npx",
            "vitest",
            "run",
