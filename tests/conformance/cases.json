            "-m",
            "pytest",
            "tests/test_conformance.py",
            "-k",
            "replay_detection_semantics",
            "-q"
          ],
          "cwd": "sdk/python"
        }
      }
    },
    {
      "id": "revocation_subject_revoked",
      "category": "revocation",
      "description": "Revoked subject tokens are rejected where revocation list support exists.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./internal/verify",
            "-run",
            "^TestConformance_revocation_subject_revoked$",
            "-count=1"
          ]
        },
        "node": {
          "skip": "not_applicable_no_revocation_list_in_node_sdk"
        },
        "python": {
          "skip": "not_applicable_no_revocation_list_in_python_sdk"
        }
      }
    },
    {
      "id": "middleware_auth_header_handling_semantics",
      "category": "middleware",
      "description": "Missing/wrong auth header scheme is rejected as claim_missing:token.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./sdk/go/middleware",
            "-run",
