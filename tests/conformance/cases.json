            "-k",
            "audience_check_mismatch",
            "-q"
          ],
          "cwd": "sdk/python"
        }
      }
    },
    {
      "id": "replay_detection_semantics",
      "category": "verification",
      "description": "Second use of same token identity is rejected when replay cache is enabled.",
      "checks": {
        "go": {
          "command": [
            "go",
            "test",
            "./internal/verify",
            "-run",
            "^TestConformance_replay_detection_semantics$",
            "-count=1"
          ]
        },
        "node": {
          "command": [
            "npx",
            "vitest",
            "run",
            "test/conformance.test.ts",
            "-t",
            "replay_detection_semantics"
          ],
          "cwd": "sdk/node"
        },
        "python": {
          "command": [
